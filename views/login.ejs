<!DOCTYPE html>
<html>
<head>
  <title>Login - Luxury Parking</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      background-color: #000;
      background-image: url('/images/hypercar.png');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      color: #fff;
      display: flex;
      justify-content: flex-end;
      align-items: center;
      height: 100vh;
      overflow: hidden;
      box-sizing: border-box;
      padding-right: 10%;
    }

    /* Dramatic shadow overlay for text readability */
    .overlay {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background: linear-gradient(90deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.9) 100%);
      z-index: 0;
    }

    .container {
      position: relative;
      z-index: 1;
      background: rgba(10, 10, 10, 0.7);
      backdrop-filter: blur(25px);
      padding: 60px 50px;
      border: 1px solid rgba(0, 229, 255, 0.3);
      width: 100%;
      max-width: 420px;
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.9), inset 0 0 20px rgba(0, 229, 255, 0.05);
      animation: fadeIn 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      opacity: 0;
      transform: translateY(20px);
    }

    @keyframes fadeIn {
      to { opacity: 1; transform: translateY(0); }
    }

    h2 {
      margin-top: 0;
      margin-bottom: 40px;
      color: #fff;
      font-size: 36px;
      font-weight: 300;
      letter-spacing: 2px;
      text-transform: uppercase;
      border-bottom: 2px solid #00e5ff;
      padding-bottom: 15px;
      display: inline-block;
    }

    .form-group {
      margin-bottom: 30px;
      text-align: left;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-size: 11px;
      font-weight: 600;
      color: #888;
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }

    input[type="email"], input[type="password"], input[type="text"] {
      width: 100%;
      padding: 15px 0;
      border: none;
      border-bottom: 1px solid #444;
      background: transparent;
      color: #fff;
      font-family: 'Inter', sans-serif;
      font-size: 16px;
      box-sizing: border-box;
      transition: all 0.4s ease;
    }

    input:focus {
      outline: none;
      border-bottom-color: #00e5ff;
      box-shadow: 0 10px 10px -10px rgba(0, 229, 255, 0.3);
    }

    input::placeholder {
      color: #333;
    }

    .btn {
      width: 100%;
      padding: 18px;
      background: transparent;
      border: 1px solid #00e5ff;
      color: #00e5ff;
      cursor: pointer;
      font-weight: 400;
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 2px;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      margin-top: 20px;
      position: relative;
      overflow: hidden;
    }

    .btn::before {
      content: '';
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background: #00e5ff;
      z-index: -1;
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .btn:hover {
      color: #000;
      font-weight: 600;
    }

    .btn:hover::before {
      transform: scaleX(1);
      transform-origin: left;
    }

    .message {
      padding: 15px;
      margin-bottom: 30px;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.5px;
      border-left: 3px solid transparent;
    }

    .message.error {
      background: rgba(0, 229, 255, 0.1);
      border-left-color: #00e5ff;
      color: #ff8888;
    }

    .message.success {
      background: rgba(255, 255, 255, 0.1);
      border-left-color: #fff;
      color: #ddd;
    }

    .footer-link {
      margin-top: 30px;
      font-size: 12px;
      color: #666;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .footer-link a {
      color: #fff;
      text-decoration: none;
      transition: color 0.3s ease;
      border-bottom: 1px solid #444;
      padding-bottom: 2px;
    }

    .footer-link a:hover {
      color: #00e5ff;
      border-bottom-color: #00e5ff;
    }
    
    /* Branding */
    .brand {
      position: absolute;
      top: 40px;
      left: 50px;
      z-index: 2;
      color: #fff;
      font-weight: 300;
      font-size: 24px;
      letter-spacing: 4px;
      text-transform: uppercase;
    }
    .brand span {
      color: #00e5ff;
      font-weight: 700;
    }
  </style>
</head>
<body>

<div class="overlay"></div>
<div class="brand">Scuderia <span>Parking</span></div>

<div class="container">
  <h2>Sign In</h2>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="message error"><%= error %></div>
  <% } %>
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="message success"><%= success %></div>
  <% } %>

  <form method="POST" action="/login">
    <div class="form-group">
      <label for="email">Email Address</label>
      <input type="email" id="email" name="email" required placeholder="driver@scuderia.com">
    </div>
    
    <div class="form-group">
      <label for="password">Access Code</label>
      <input type="password" id="password" name="password" required placeholder="••••••••">
    </div>

    <button type="submit" class="btn">Authenticate</button>
    
    <div class="footer-link">
      Unregistered? <a href="/register">Request Access</a>
    </div>
  </form>
</div>

</body>
</html>
