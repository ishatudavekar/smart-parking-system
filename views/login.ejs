<!DOCTYPE html>
<html>
<head>
  <title>Login - Smart Parking</title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      font-family: 'Outfit', sans-serif;
      background: radial-gradient(circle at top left, #1e1b4b, #0f172a);
      color: #f8fafc;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      overflow: hidden;
    }

    /* Animated background elements */
    .bg-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      z-index: -1;
      animation: float 10s infinite alternate ease-in-out;
    }
    .orb-1 {
      width: 300px; height: 300px;
      background: rgba(56, 189, 248, 0.15);
      top: -100px; left: -100px;
    }
    .orb-2 {
      width: 400px; height: 400px;
      background: rgba(168, 85, 247, 0.15);
      bottom: -150px; right: -100px;
      animation-delay: -5s;
    }
    @keyframes float {
      0% { transform: translateY(0px) scale(1); }
      100% { transform: translateY(30px) scale(1.1); }
    }

    .container {
      background: rgba(255, 255, 255, 0.03);
      backdrop-filter: blur(20px);
      padding: 50px 40px;
      border-radius: 24px;
      border: 1px solid rgba(255, 255, 255, 0.05);
      width: 100%;
      max-width: 380px;
      text-align: center;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      transition: transform 0.3s ease;
    }

    .container:hover {
      border-color: rgba(255, 255, 255, 0.1);
    }

    h2 {
      margin-top: 0;
      margin-bottom: 30px;
      background: linear-gradient(135deg, #38bdf8, #c084fc);
      -webkit-background-clip: text;
      color: transparent;
      font-size: 32px;
      font-weight: 700;
      letter-spacing: -0.5px;
    }

    .form-group {
      margin-bottom: 24px;
      text-align: left;
    }

    label {
      display: block;
      margin-bottom: 8px;
      font-size: 14px;
      font-weight: 500;
      color: #94a3b8;
    }

    input[type="email"], input[type="password"], input[type="text"] {
      width: 100%;
      padding: 14px 16px;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(0, 0, 0, 0.2);
      color: #f8fafc;
      font-family: 'Outfit', sans-serif;
      font-size: 15px;
      box-sizing: border-box;
      transition: all 0.3s ease;
    }

    input:focus {
      outline: none;
      border-color: #38bdf8;
      background: rgba(0, 0, 0, 0.4);
      box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.1);
    }

    .btn {
      width: 100%;
      padding: 14px;
      border-radius: 12px;
      border: none;
      cursor: pointer;
      font-weight: 600;
      font-family: 'Outfit', sans-serif;
      font-size: 16px;
      letter-spacing: 0.5px;
      transition: all 0.3s ease;
      color: white;
      background: linear-gradient(135deg, #38bdf8, #818cf8);
      margin-top: 10px;
      box-shadow: 0 4px 15px rgba(56, 189, 248, 0.3);
    }

    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(56, 189, 248, 0.4);
    }

    .btn:active {
      transform: translateY(0);
    }

    .message {
      padding: 12px;
      border-radius: 10px;
      margin-bottom: 24px;
      font-size: 14px;
      font-weight: 500;
      animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-5px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .message.error {
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.2);
      color: #fca5a5;
    }

    .footer-link {
      margin-top: 24px;
      font-size: 14px;
      color: #64748b;
    }

    .footer-link a {
      color: #38bdf8;
      text-decoration: none;
      font-weight: 500;
      transition: color 0.3s ease;
    }

    .footer-link a:hover {
      color: #7dd3fc;
    }
  </style>
</head>
<body>

<div class="bg-orb orb-1"></div>
<div class="bg-orb orb-2"></div>

<div class="container">
  <img src="/images/car.png" alt="3D Car" style="width: 180px; margin-top: -110px; margin-bottom: 10px; filter: drop-shadow(0 15px 25px rgba(56, 189, 248, 0.3)); animation: float 6s infinite alternate ease-in-out;">
  <h2>Smart Parking</h2>

  <% if (error) { %>
    <div class="message error"><%= error %></div>
  <% } %>

  <form method="POST" action="/login">
    <div class="form-group">
      <label for="email">Email Address</label>
      <input type="email" id="email" name="email" required placeholder="name@company.com">
    </div>
    
    <div class="form-group">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" required placeholder="••••••••">
    </div>

    <button type="submit" class="btn">Sign In</button>
    
    <div class="footer-link">
      Don't have an account? <a href="/register">Create one</a>
    </div>
  </form>
</div>

</body>
</html>
