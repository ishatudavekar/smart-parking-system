<!DOCTYPE html>
<html>
<head>
  <title>Dashboard - Smart Parking</title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      font-family: 'Outfit', sans-serif;
      background: #0f172a;
      color: #f8fafc;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Animated background elements */
    .bg-orb {
      position: fixed;
      border-radius: 50%;
      filter: blur(100px);
      z-index: -1;
      animation: float 15s infinite alternate ease-in-out;
      opacity: 0.5;
    }
    .orb-1 {
      width: 500px; height: 500px;
      background: rgba(56, 189, 248, 0.15);
      top: -200px; right: -100px;
    }
    .orb-2 {
      width: 600px; height: 600px;
      background: rgba(168, 85, 247, 0.1);
      bottom: -200px; left: -200px;
      animation-delay: -7s;
    }
    @keyframes float {
      0% { transform: translate(0px, 0px) scale(1); }
      100% { transform: translate(50px, 50px) scale(1.2); }
    }

    /* Navbar */
    .navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 40px;
      background: rgba(15, 23, 42, 0.8);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .navbar h2 {
      margin: 0;
      background: linear-gradient(135deg, #38bdf8, #c084fc);
      -webkit-background-clip: text;
      color: transparent;
      font-size: 24px;
      font-weight: 700;
      letter-spacing: -0.5px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .user {
      font-size: 14px;
      font-weight: 500;
      color: #cbd5e1;
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .logout {
      color: #fca5a5;
      text-decoration: none;
      padding: 6px 16px;
      border-radius: 8px;
      background: rgba(239, 68, 68, 0.1);
      transition: all 0.3s ease;
      font-weight: 600;
      border: 1px solid rgba(239, 68, 68, 0.2);
    }

    .logout:hover {
      background: rgba(239, 68, 68, 0.2);
      transform: translateY(-1px);
    }

    /* Container */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px;
    }

    .header-section {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
    }

    h1 {
      margin: 0;
      font-size: 32px;
      font-weight: 700;
      letter-spacing: -0.5px;
    }

    /* Cards */
    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
      margin-bottom: 50px;
    }

    .card {
      padding: 30px;
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.02);
      backdrop-filter: blur(20px);
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      border: 1px solid rgba(255, 255, 255, 0.05);
      position: relative;
      overflow: hidden;
    }

    .card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; height: 3px;
    }

    .card:hover {
      transform: translateY(-8px);
      background: rgba(255, 255, 255, 0.04);
    }

    .card h3 {
      margin: 0 0 10px 0;
      font-weight: 500;
      color: #94a3b8;
      font-size: 16px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .card p {
      margin: 0;
      font-size: 42px;
      font-weight: 700;
      line-height: 1;
    }

    /* Card Themes */
    .card.blue::before { background: linear-gradient(90deg, #38bdf8, #0ea5e9); }
    .card.blue:hover { box-shadow: 0 20px 40px -10px rgba(56, 189, 248, 0.2); }
    .card.blue p { color: #f8fafc; }

    .card.green::before { background: linear-gradient(90deg, #4ade80, #22c55e); }
    .card.green:hover { box-shadow: 0 20px 40px -10px rgba(74, 222, 128, 0.2); }
    .card.green p { color: #4ade80; }

    .card.red::before { background: linear-gradient(90deg, #f87171, #ef4444); }
    .card.red:hover { box-shadow: 0 20px 40px -10px rgba(248, 113, 113, 0.2); }
    .card.red p { color: #f87171; }

    /* Actions */
    .actions {
      display: flex;
      gap: 16px;
    }

    .btn {
      padding: 12px 24px;
      border-radius: 12px;
      border: none;
      cursor: pointer;
      font-weight: 600;
      font-family: 'Outfit', sans-serif;
      font-size: 15px;
      transition: all 0.3s ease;
      text-decoration: none;
      color: white;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .btn-entry {
      background: linear-gradient(135deg, #22c55e, #10b981);
      box-shadow: 0 4px 15px rgba(34, 197, 94, 0.3);
    }

    .btn-exit {
      background: linear-gradient(135deg, #ef4444, #db2777);
      box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
    }

    .btn:hover {
      transform: translateY(-2px);
    }

    .btn-entry:hover { box-shadow: 0 8px 25px rgba(34, 197, 94, 0.4); }
    .btn-exit:hover { box-shadow: 0 8px 25px rgba(239, 68, 68, 0.4); }

    /* Table */
    .table-container {
      background: rgba(255, 255, 255, 0.02);
      border-radius: 20px;
      border: 1px solid rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(20px);
      overflow: hidden;
      margin-top: 20px;
    }

    .table-header {
      padding: 24px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .table-header h2 {
      margin: 0;
      font-size: 20px;
      font-weight: 600;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    th {
      padding: 16px 24px;
      color: #94a3b8;
      font-weight: 500;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      background: rgba(0, 0, 0, 0.2);
    }

    td {
      padding: 16px 24px;
      color: #cbd5e1;
      font-size: 15px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    }

    tr {
      transition: background 0.3s ease;
    }

    tr:hover {
      background: rgba(255, 255, 255, 0.03);
    }

    .vehicle-badge {
      background: rgba(56, 189, 248, 0.1);
      color: #38bdf8;
      padding: 6px 12px;
      border-radius: 6px;
      font-weight: 600;
      font-size: 14px;
      display: inline-block;
      border: 1px solid rgba(56, 189, 248, 0.2);
    }

    .slot-badge {
      background: rgba(148, 163, 184, 0.1);
      color: #cbd5e1;
      padding: 4px 10px;
      border-radius: 6px;
      font-weight: 500;
      font-size: 14px;
      display: inline-block;
    }

    .empty-state {
      padding: 40px;
      text-align: center;
      color: #64748b;
    }

  </style>
</head>
<body>

<div class="bg-orb orb-1"></div>
<div class="bg-orb orb-2"></div>

<div class="navbar">
  <h2><span>🚗</span> Smart Parking</h2>
  <div class="user">
    <%= name %>
    <a href="/logout" class="logout">Sign Out</a>
  </div>
</div>

<div class="container">
  <div class="header-section">
    <h1>Overview</h1>
    <div class="actions">
      <a href="/entry" class="btn btn-entry">+ Park Vehicle</a>
      <a href="/exit" class="btn btn-exit">- Process Exit</a>
    </div>
  </div>

  <div class="cards">
    <div class="card blue">
      <h3>Total Capacity</h3>
      <p><%= total %></p>
    </div>

    <div class="card green">
      <h3>Available Slots</h3>
      <p><%= available %></p>
    </div>

    <div class="card red">
      <h3>Occupied</h3>
      <p><%= occupied %></p>
    </div>
  </div>

  <div class="table-container">
    <div class="table-header">
      <h2>Active Parking Sessions</h2>
    </div>
    
    <% if (vehicles && vehicles.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>Vehicle No</th>
            <th>Slot ID</th>
            <th>Entry Time</th>
          </tr>
        </thead>
        <tbody>
          <% vehicles.forEach(function(row) { %>
            <tr>
              <td><span class="vehicle-badge"><%= row.vehicle_no %></span></td>
              <td><span class="slot-badge">Slot <%= row.slot_id %></span></td>
              <td><%= new Date(row.entry_time).toLocaleString(undefined, { weekday: 'short', month: 'short', day: 'numeric', hour: '2-digit', minute:'2-digit' }) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } else { %>
      <div class="empty-state">
        <p>No vehicles are currently parked. The lot is completely empty.</p>
      </div>
    <% } %>
  </div>
</div>

</body>
</html>
