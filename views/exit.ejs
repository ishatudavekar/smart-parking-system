<!DOCTYPE html>
<html>
<head>
  <title>Exit Vehicle - Smart Parking</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;600&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      font-family: 'Poppins', sans-serif;
      background: #000;
      color: white;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }

    .container {
      background: rgba(255,255,255,0.05);
      backdrop-filter: blur(15px);
      padding: 40px;
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.08);
      width: 100%;
      max-width: 400px;
      text-align: center;
      box-shadow: 0 0 20px rgba(239, 68, 68, 0.2);
    }

    h2 {
      margin-top: 0;
      margin-bottom: 20px;
      background: linear-gradient(45deg, #ef4444, #dc2626);
      -webkit-background-clip: text;
      color: transparent;
    }

    .form-group {
      margin-bottom: 20px;
      text-align: left;
    }

    label {
      display: block;
      margin-bottom: 8px;
      font-size: 14px;
      color: #ccc;
    }

    input[type="text"] {
      width: 100%;
      padding: 12px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,0.2);
      background: rgba(0,0,0,0.2);
      color: white;
      font-family: 'Poppins', sans-serif;
      box-sizing: border-box;
      transition: 0.3s;
    }

    input[type="text"]:focus {
      outline: none;
      border-color: #ef4444;
      box-shadow: 0 0 10px rgba(239, 68, 68, 0.3);
    }

    .btn {
      width: 100%;
      padding: 12px;
      border-radius: 10px;
      border: none;
      cursor: pointer;
      font-weight: 500;
      font-family: 'Poppins', sans-serif;
      font-size: 16px;
      transition: 0.3s;
      color: white;
      background: linear-gradient(45deg, #ef4444, #dc2626);
      margin-bottom: 15px;
    }

    .btn:hover {
      transform: scale(1.02);
      box-shadow: 0 0 15px rgba(239, 68, 68, 0.4);
    }

    .back-link {
      color: #0ea5e9;
      text-decoration: none;
      font-size: 14px;
      transition: 0.3s;
    }

    .back-link:hover {
      text-decoration: underline;
      text-shadow: 0 0 10px rgba(14, 165, 233, 0.5);
    }

    .message {
      padding: 10px;
      border-radius: 8px;
      margin-bottom: 20px;
      font-size: 14px;
    }

    .message.error {
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #ef4444;
    }

    .message.success {
      background: rgba(34, 197, 94, 0.1);
      border: 1px solid rgba(34, 197, 94, 0.3);
      color: #22c55e;
    }

    .receipt {
      background: rgba(255,255,255,0.1);
      padding: 20px;
      border-radius: 10px;
      margin-bottom: 20px;
      text-align: left;
      border: 1px dashed rgba(255,255,255,0.3);
    }
    .receipt h3 {
      margin-top: 0;
      text-align: center;
      color: #38bdf8;
    }
    .receipt p {
      margin: 5px 0;
      font-size: 14px;
      color: #ccc;
    }
    .receipt .cost {
      font-size: 18px;
      color: #22c55e;
      font-weight: 600;
      text-align: center;
      margin-top: 10px;
      border-top: 1px solid rgba(255,255,255,0.1);
      padding-top: 10px;
    }
  </style>
</head>
<body>

<div class="container">
  <h2>- Exit Vehicle</h2>

  <% if (error) { %>
    <div class="message error"><%= error %></div>
  <% } %>

  <% if (success) { %>
    <div class="message success"><%= success %></div>
  <% } %>

  <% if (typeof receipt !== 'undefined' && receipt) { %>
    <div class="receipt">
      <h3>Parking Receipt</h3>
      <p><strong>Vehicle No:</strong> <%= receipt.vehicle_no %></p>
      <p><strong>Entry Time:</strong> <%= receipt.entry_time %></p>
      <p><strong>Exit Time:</strong> <%= receipt.exit_time %></p>
      <p><strong>Duration:</strong> <%= receipt.duration %></p>
      <p class="cost"><strong>Total Cost:</strong> <%= receipt.cost %></p>
    </div>
  <% } %>

  <form method="POST" action="/exit">
    <div class="form-group">
      <label for="vehicle_no">Vehicle Number</label>
      <input type="text" id="vehicle_no" name="vehicle_no" required placeholder="e.g. AB-12-CD-3456" autocomplete="off">
    </div>
    <button type="submit" class="btn">Process Exit</button>
  </form>

  <a href="/dashboard" class="back-link">← Back to Dashboard</a>
</div>

</body>
</html>
