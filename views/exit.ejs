<!DOCTYPE html>
<html>
<head>
  <title>Exit - Luxury Parking</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      background-color: #000;
      background-image: url('/images/hypercar.png');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      color: #fff;
      display: flex;
      justify-content: flex-end;
      align-items: center;
      min-height: 100vh;
      overflow-y: auto;
      box-sizing: border-box;
      padding: 40px 10% 40px 20px;
    }

    .overlay {
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: linear-gradient(90deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.9) 100%);
      z-index: 0;
    }

    .container {
      position: relative;
      z-index: 1;
      background: rgba(10, 10, 10, 0.7);
      backdrop-filter: blur(25px);
      padding: 60px 50px;
      border: 1px solid rgba(255, 40, 0, 0.3);
      width: 100%;
      max-width: 420px;
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.9), inset 0 0 20px rgba(255, 40, 0, 0.05);
      animation: fadeIn 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      opacity: 0;
      transform: translateY(20px);
    }

    @keyframes fadeIn {
      to { opacity: 1; transform: translateY(0); }
    }

    h2 {
      margin-top: 0;
      margin-bottom: 40px;
      color: #fff;
      font-size: 36px;
      font-weight: 300;
      letter-spacing: 2px;
      text-transform: uppercase;
      border-bottom: 2px solid #ff2800;
      padding-bottom: 15px;
      display: inline-block;
    }

    .form-group {
      margin-bottom: 30px;
      text-align: left;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-size: 11px;
      font-weight: 600;
      color: #888;
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }

    input[type="text"] {
      width: 100%;
      padding: 15px 0;
      border: none;
      border-bottom: 1px solid #444;
      background: transparent;
      color: #fff;
      font-family: 'Inter', sans-serif;
      font-size: 16px;
      box-sizing: border-box;
      transition: all 0.4s ease;
      text-transform: uppercase;
    }

    input:focus {
      outline: none;
      border-bottom-color: #ff2800;
      box-shadow: 0 10px 10px -10px rgba(255, 40, 0, 0.3);
    }

    input::placeholder {
      color: #333;
      text-transform: none;
    }

    .btn {
      width: 100%;
      padding: 18px;
      background: transparent;
      border: 1px solid #ff2800;
      color: #ff2800;
      cursor: pointer;
      font-weight: 400;
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 2px;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      margin-top: 10px;
      margin-bottom: 30px;
      position: relative;
      overflow: hidden;
    }

    .btn::before {
      content: '';
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background: #ff2800;
      z-index: -1;
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .btn:hover {
      color: #000;
      font-weight: 600;
    }

    .btn:hover::before {
      transform: scaleX(1);
      transform-origin: left;
    }

    .message {
      padding: 15px;
      margin-bottom: 30px;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.5px;
      border-left: 3px solid transparent;
    }

    .message.error {
      background: rgba(255, 40, 0, 0.1);
      border-left-color: #ff2800;
      color: #ff8888;
    }

    .message.success {
      background: rgba(255, 255, 255, 0.1);
      border-left-color: #fff;
      color: #ddd;
    }

    .back-link {
      display: inline-block;
      color: #666;
      text-decoration: none;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      transition: all 0.3s ease;
      border-bottom: 1px solid transparent;
      padding-bottom: 2px;
    }

    .back-link:hover {
      color: #fff;
      border-bottom-color: #fff;
    }

    /* Luxury Receipt Styling */
    .receipt {
      background: rgba(0, 0, 0, 0.4);
      padding: 30px;
      border: 1px solid #333;
      margin-bottom: 30px;
      text-align: left;
      position: relative;
    }
    
    .receipt::before {
      content: '';
      position: absolute;
      top: 0; left: 0; width: 100%; height: 2px;
      background: linear-gradient(90deg, transparent, #ff2800, transparent);
    }

    .receipt h3 {
      margin-top: 0;
      text-align: left;
      color: #fff;
      font-weight: 300;
      letter-spacing: 3px;
      margin-bottom: 25px;
      text-transform: uppercase;
      font-size: 14px;
      border-bottom: 1px solid #333;
      padding-bottom: 10px;
    }

    .receipt-row {
      display: flex;
      justify-content: space-between;
      margin: 12px 0;
      font-size: 12px;
    }

    .receipt-label {
      color: #888;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .receipt-value {
      color: #fff;
      font-weight: 500;
      font-family: monospace;
      font-size: 13px;
    }

    .receipt .cost {
      font-size: 24px;
      color: #ff2800;
      font-weight: 300;
      text-align: right;
      margin-top: 25px;
      border-top: 1px solid #333;
      padding-top: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .receipt .cost span:first-child {
      font-size: 11px;
      color: #888;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 2px;
    }
    
    .brand {
      position: fixed;
      top: 40px;
      left: 50px;
      z-index: 2;
      color: #fff;
      font-weight: 300;
      font-size: 24px;
      letter-spacing: 4px;
      text-transform: uppercase;
    }
    .brand span {
      color: #ff2800;
      font-weight: 700;
    }
  </style>
</head>
<body>

<div class="overlay"></div>
<div class="brand">Scuderia <span>Parking</span></div>

<div class="container">
  <h2>Process Exit</h2>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="message error"><%= error %></div>
  <% } %>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="message success"><%= success %></div>
  <% } %>

  <% if (typeof receipt !== 'undefined' && receipt) { %>
    <div class="receipt">
      <h3>Invoice</h3>
      <div class="receipt-row">
        <span class="receipt-label">License Plate</span>
        <span class="receipt-value"><%= receipt.vehicle_no %></span>
      </div>
      <div class="receipt-row">
        <span class="receipt-label">Entry Log</span>
        <span class="receipt-value"><%= receipt.entry_time %></span>
      </div>
      <div class="receipt-row">
        <span class="receipt-label">Exit Log</span>
        <span class="receipt-value"><%= receipt.exit_time %></span>
      </div>
      <div class="receipt-row">
        <span class="receipt-label">Duration</span>
        <span class="receipt-value"><%= receipt.duration %></span>
      </div>
      <div class="cost">
        <span>Total Due</span>
        <span><%= receipt.cost %></span>
      </div>
    </div>
  <% } %>

  <form method="POST" action="/exit">
    <div class="form-group">
      <label for="vehicle_no">License Plate</label>
      <input type="text" id="vehicle_no" name="vehicle_no" required placeholder="SF90-STRADALE" autocomplete="off">
    </div>
    <button type="submit" class="btn">Calculate Invoice</button>
  </form>

  <a href="/dashboard" class="back-link">Return to Command Center</a>
</div>

</body>
</html>
