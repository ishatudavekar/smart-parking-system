<!DOCTYPE html>
<html>
<head>
  <title>Entry - Luxury Parking</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      background-color: #f5f5f7;
      background-image: url('/images/hypercar.png');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      color: #1d1d1f;
      display: flex;
      justify-content: flex-end;
      align-items: center;
      height: 100vh;
      overflow: hidden;
      box-sizing: border-box;
      padding-right: 10%;
    }

    .overlay {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background: linear-gradient(90deg, rgba(245,245,247,0.9) 0%, rgba(245,245,247,0.3) 50%, rgba(245,245,247,0.95) 100%);
      z-index: 0;
    }

    .container {
      position: relative;
      z-index: 1;
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(25px);
      padding: 60px 50px;
      border: 1px solid rgba(197, 160, 89, 0.3);
      width: 100%;
      max-width: 420px;
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.05), inset 0 0 20px rgba(255, 255, 255, 0.5);
      animation: fadeIn 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      opacity: 0;
      transform: translateY(20px);
    }

    @keyframes fadeIn {
      to { opacity: 1; transform: translateY(0); }
    }

    h2 {
      margin-top: 0;
      margin-bottom: 40px;
      color: #1d1d1f;
      font-size: 36px;
      font-weight: 300;
      letter-spacing: 2px;
      text-transform: uppercase;
      border-bottom: 2px solid #c5a059;
      padding-bottom: 15px;
      display: inline-block;
    }

    .form-group {
      margin-bottom: 30px;
      text-align: left;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-size: 11px;
      font-weight: 600;
      color: #888;
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }

    input[type="text"] {
      width: 100%;
      padding: 15px 0;
      border: none;
      border-bottom: 1px solid #ddd;
      background: transparent;
      color: #1d1d1f;
      font-family: 'Inter', sans-serif;
      font-size: 16px;
      box-sizing: border-box;
      transition: all 0.4s ease;
      text-transform: uppercase;
    }

    input:focus {
      outline: none;
      border-bottom-color: #c5a059;
      box-shadow: 0 10px 10px -10px rgba(197, 160, 89, 0.2);
    }

    input::placeholder {
      color: #aaa;
      text-transform: none;
    }

    .btn {
      width: 100%;
      padding: 18px;
      background: transparent;
      border: 1px solid #c5a059;
      color: #c5a059;
      cursor: pointer;
      font-weight: 500;
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 2px;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      margin-top: 20px;
      margin-bottom: 30px;
      position: relative;
      overflow: hidden;
    }

    .btn::before {
      content: '';
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background: #c5a059;
      z-index: -1;
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .btn:hover {
      color: #fff;
      font-weight: 600;
    }

    .btn:hover::before {
      transform: scaleX(1);
      transform-origin: left;
    }

    .message {
      padding: 15px;
      margin-bottom: 30px;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.5px;
      border-left: 3px solid transparent;
    }

    .message.error {
      background: rgba(255, 40, 0, 0.05);
      border-left-color: #ff2800;
      color: #d00;
    }

    .message.success {
      background: rgba(197, 160, 89, 0.1);
      border-left-color: #c5a059;
      color: #c5a059;
    }

    .back-link {
      display: inline-block;
      color: #888;
      text-decoration: none;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      transition: all 0.3s ease;
      border-bottom: 1px solid transparent;
      padding-bottom: 2px;
    }

    .back-link:hover {
      color: #1d1d1f;
      border-bottom-color: #1d1d1f;
    }

    .brand {
      position: absolute;
      top: 40px;
      left: 50px;
      z-index: 2;
      color: #1d1d1f;
      font-weight: 300;
      font-size: 24px;
      letter-spacing: 4px;
      text-transform: uppercase;
    }
    .brand span {
      color: #c5a059;
      font-weight: 700;
    }
  </style>
</head>
<body>

<div class="overlay"></div>
<div class="brand">Scuderia <span>Parking</span></div>

<div class="container">
  <h2>Log Entry</h2>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="message error"><%= error %></div>
  <% } %>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="message success"><%= success %></div>
  <% } %>

  <form method="POST" action="/entry">
    <div class="form-group">
      <label for="vehicle_no">License Plate</label>
      <input type="text" id="vehicle_no" name="vehicle_no" required placeholder="SF90-STRADALE" autocomplete="off">
    </div>
    <button type="submit" class="btn">Authorize Vehicle</button>
  </form>

  <a href="/dashboard" class="back-link">Return to Command Center</a>
</div>

</body>
</html>
